# ==========================================
# Student Record Management System - Config
# ==========================================

# Server Port
PORT=3000

# AWS Configuration
# AWS Region (e.g. ap-south-1, us-east-1, us-west-2, eu-west-1)
AWS_REGION=ap-south-1

# DynamoDB Table Name (Partition Key must be 'studentId')
DYNAMODB_TABLE_NAME=StudentRecords

# Optional Local AWS Credentials (DO NOT commit real keys to Git!)
# When deployed on EC2 with an attached IAM Role, leave these blank/commented out.
# The AWS SDK will automatically authenticate via the EC2 Instance Metadata Service (IMDS).
# AWS_ACCESS_KEY_ID=your_access_key_id_here
# AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# Force Mock Mode (Set to true to always use in-memory mock data even if AWS credentials exist)
FORCE_MOCK_MODE=false
